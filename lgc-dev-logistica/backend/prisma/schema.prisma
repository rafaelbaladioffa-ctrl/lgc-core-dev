  DISPONIVEL
  MANUTENCAO
  QUARENTENA
  AVARIADO_REPARO
  SUCATA
}

enum ReturnItemStatus {
  PENDENTE_INSPECAO
  CLASSIFICADO
}

enum ReturnStatus {
  RECEBIDA
  ENCERRADA
}

model CustodyTerm {
  id               String        @id @default(uuid())
  seq              Int           @unique @default(autoincrement())
  custodianAxisId  String        @map("custodian_axis_id")
  materialId       String        @map("material_id")
