// Sprint 10 — Reconciliação (12.4): divergência vira fila, nunca correção silenciosa
// ---------------------------------------------------------------------------

enum IssueStatus {
  ABERTA
  RESOLVIDA
}

model ReconciliationIssue {
  id         String      @id @default(uuid())
  kind       String // BALANCE_VS_LEDGER | RESERVED_DRIFT | ORPHAN_RESERVATION | OUTBOX_DEAD_LETTER | ...
  severity   String      @default("ATENCAO")
