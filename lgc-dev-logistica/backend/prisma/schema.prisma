// ---------------------------------------------------------------------------
// Sprint 2 — Integração com o Axis (seção 12)
// ---------------------------------------------------------------------------

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
  PENDING
  DELIVERED
}

/// Inbox (idempotência por event_id) e outbox transacional (Logística → Axis).
model IntegrationMessage {
  id            String           @id @default(uuid())
  direction     MessageDirection
  eventId       String           @map("event_id")
  eventType     String           @map("event_type")
  occurredAt    DateTime         @map("occurred_at")
  payload       Json
  status        MessageStatus
  attempts      Int              @default(0)
  lastError     String?          @map("last_error")
  correlationId String?          @map("correlation_id")
  nextAttemptAt DateTime?        @map("next_attempt_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  processedAt   DateTime?        @map("processed_at")

  @@unique([direction, eventId])
  @@index([direction, status, nextAttemptAt])
  @@map("integration_messages")
}

/// Cache dos mestres do Axis (empresa, unidade, usuário, colaborador, cliente, projeto, centro de custo):
/// guarda só identificador externo + dados mínimos; nunca é editável aqui (3.3).
model AxisMasterCache {
  kind             String // USER | COLLABORATOR | CLIENT | PROJECT | COST_CENTER | SITE | COMPANY | UNIT
  axisId           String   @map("axis_id")
  code             String?
  name             String?
  active           Boolean  @default(true)
  data             Json     @default("{}")
  sourceOccurredAt DateTime @map("source_occurred_at") // controle de versão/ordem de eventos (12.4)
  syncedAt         DateTime @default(now()) @map("synced_at")

  @@id([kind, axisId])
  @@index([kind, active])
  @@map("axis_master_cache")
}
