{
  "name": "financeiro-backend",
  "version": "0.0.1",
  "description": "Axis Financeiro — API do satélite financeiro (projetos e contas a pagar)",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "dev:setup": "prisma migrate deploy && prisma db seed",
    "lint": "oxlint --type-aware src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^5.22.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fast-xml-parser": "4.5.0",
    "helmet": "^8.3.0",
    "jszip": "3.10.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfjs-dist": "4.10.38",
    "prisma": "^5.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "source-map-support": "^0.5.21",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  },
  "allowScripts": {
    "prisma@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "@prisma/client@5.22.0": true,
    "esbuild@0.28.2": true
  }
}
