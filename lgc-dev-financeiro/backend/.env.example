DATABASE_URL="postgresql://financeiro:financeiro@localhost:5434/axis_financeiro?schema=public"
PORT=3200

# Mesmo segredo de acesso (HS256) que o Core usa para assinar o access token (JWT_ACCESS_SECRET do Core).
JWT_SECRET="replace-with-same-value-as-axis-JWT_ACCESS_SECRET"

# Origens do frontend do Financeiro, separadas por vírgula.
CORS_ALLOWED_ORIGINS="http://localhost:5175"

# Segredo HMAC do webhook Core → Financeiro (entregue pelo Core ao cadastrar o satélite).
AXIS_WEBHOOK_SECRET="dev-webhook-secret-change-me-0123456789"
WEBHOOK_MAX_AGE_HOURS=72

# Entrega de eventos Financeiro → Core (outbox). Vazio = não envia; os eventos ficam PENDING.
# API do Core para "Atualizar do Axis Core" (projetos e clientes, com o token de quem clicou).
AXIS_API_URL="http://localhost:3000/api/v1"
# API key do satélite Financeiro no Core (entregue ao cadastrar o satélite). Usada para baixar a SOW e o
# Bid Template do pedido de cotação; o satélite precisa assinar project.document_added e project.quote_requested.
AXIS_API_KEY=""

AXIS_EVENTS_URL=""
AXIS_OUTBOUND_SECRET=""
# Ligue em UMA instância: entrega do outbox a cada 30 s.
SCHEDULER_ENABLED=false
