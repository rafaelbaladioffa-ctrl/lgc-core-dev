generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// F0 — infraestrutura: RBAC local, auditoria, integração com o Core.
// O domínio de contas a pagar (F1–F3) entra em migrações próprias.
// ---------------------------------------------------------------------------

model FinancePermission {
  id          String @id @default(uuid())
  code        String @unique // "recurso:acao", ex.: payable:approve
  description String

  roles RolePermission[]

  @@map("finance_permissions")
}

model FinanceRole {
  id          String   @id @default(uuid())
  code        String   @unique // ex.: TESOURARIA
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  permissions  RolePermission[]
  axisMappings AxisRoleToFinanceRole[]
  userGrants   UserFinanceRole[]

  @@map("finance_roles")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       FinanceRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission FinancePermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Papel vindo no JWT do Core → perfis do Financeiro; editável sem redeploy do Core.
model AxisRoleToFinanceRole {
  axisRole      String @map("axis_role")
  financeRoleId String @map("finance_role_id")

  financeRole FinanceRole @relation(fields: [financeRoleId], references: [id], onDelete: Cascade)

  @@id([axisRole, financeRoleId])
  @@map("axis_role_to_finance_role")
}

/// Perfil concedido a um usuário específico do Core, somado ao que vem do mapeamento por papel.
model UserFinanceRole {
  axisUserId    String   @map("axis_user_id")
  financeRoleId String   @map("finance_role_id")
  grantedBy     String?  @map("granted_by")
  createdAt     DateTime @default(now()) @map("created_at")

  financeRole FinanceRole @relation(fields: [financeRoleId], references: [id], onDelete: Cascade)

  @@id([axisUserId, financeRoleId])
  @@map("user_finance_roles")
}

/// Trilha append-only: o código só insere (sem rota de alteração ou remoção).
model AuditEvent {
  id            String   @id @default(uuid())
  actorAxisId   String   @map("actor_axis_id")
  action        String
  aggregateType String   @map("aggregate_type")
  aggregateId   String   @map("aggregate_id")
  diff          Json?
  origin        String?
  correlationId String?  @map("correlation_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([aggregateType, aggregateId])
  @@index([actorAxisId, createdAt])
  @@map("audit_events")
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
  PENDING
  DELIVERED
}

/// Inbox (idempotência por event_id) e outbox transacional (Financeiro → Core).
model IntegrationMessage {
  id            String           @id @default(uuid())
  direction     MessageDirection
  eventId       String           @map("event_id")
  eventType     String           @map("event_type")
  occurredAt    DateTime         @map("occurred_at")
  payload       Json
  status        MessageStatus
  attempts      Int              @default(0)
  lastError     String?          @map("last_error")
  correlationId String?          @map("correlation_id")
  nextAttemptAt DateTime?        @map("next_attempt_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  processedAt   DateTime?        @map("processed_at")

  @@unique([direction, eventId])
  @@index([direction, status, nextAttemptAt])
  @@map("integration_messages")
}

/// Cache dos mestres do Core (usuário, colaborador, cliente, projeto, centro de custo). Nunca editável aqui.
model AxisMasterCache {
  kind             String // USER | COLLABORATOR | CLIENT | PROJECT | COST_CENTER
  axisId           String   @map("axis_id")
  code             String?
  name             String?
  active           Boolean  @default(true)
  data             Json     @default("{}")
  sourceOccurredAt DateTime @map("source_occurred_at") // ordem dos eventos: o mais novo vence
  syncedAt         DateTime @default(now()) @map("synced_at")

  @@id([kind, axisId])
  @@index([kind, active])
  @@map("axis_master_cache")
}

// ---------------------------------------------------------------------------
// PJ1 — módulo Projetos: parâmetros de custo versionados e catálogos
// (docs/projetos-especificacao.md §4). Valores da empresa só no banco, nunca no Git.
// ---------------------------------------------------------------------------

enum ParameterSetStatus {
  rascunho
  vigente
  arquivado
}

/// Conjunto de parâmetros de custo, impostos e metas. Publicado, fica imutável; mudar gera nova versão.
/// Percentuais como fração (0.2 = 20%). Campos nulos só são aceitos em rascunho.
model ParameterSet {
  id            String             @id @default(uuid())
  code          String             @unique // PAR-NNNN
  status        ParameterSetStatus @default(rascunho)
  effectiveFrom DateTime?          @map("effective_from") @db.Date
  notes         String?
  basedOnId     String?            @map("based_on_id")

  // Jornada
  hoursPerDay      Decimal? @map("hours_per_day") @db.Decimal(6, 2)
  workingDaysYear  Int?     @map("working_days_year")
  vacationWorkDays Int?     @map("vacation_work_days")

  // Encargos
  inssRate          Decimal? @map("inss_rate") @db.Decimal(9, 6)
  ratRate           Decimal? @map("rat_rate") @db.Decimal(9, 6)
  thirdPartyRate    Decimal? @map("third_party_rate") @db.Decimal(9, 6)
  fgtsRate          Decimal? @map("fgts_rate") @db.Decimal(9, 6)
  fgtsFineProvision Decimal? @map("fgts_fine_provision") @db.Decimal(9, 6)
  vtSalaryDiscount  Boolean? @map("vt_salary_discount")

  // Impostos — lucro presumido
  pisRate         Decimal? @map("pis_rate") @db.Decimal(9, 6)
  cofinsRate      Decimal? @map("cofins_rate") @db.Decimal(9, 6)
  issRate         Decimal? @map("iss_rate") @db.Decimal(9, 6)
  irpjPresumption Decimal? @map("irpj_presumption") @db.Decimal(9, 6)
  irpjRate        Decimal? @map("irpj_rate") @db.Decimal(9, 6)
  irpjSurcharge   Boolean? @map("irpj_surcharge")
  csllPresumption Decimal? @map("csll_presumption") @db.Decimal(9, 6)
  csllRate        Decimal? @map("csll_rate") @db.Decimal(9, 6)

  // Veículo
  kmRate            Decimal? @map("km_rate") @db.Decimal(14, 2)
  fuelKmPerLiter    Decimal? @map("fuel_km_per_liter") @db.Decimal(8, 2)
  fuelPricePerLiter Decimal? @map("fuel_price_per_liter") @db.Decimal(14, 2)
  vehicleWearPerKm  Decimal? @map("vehicle_wear_per_km") @db.Decimal(14, 4)

  // Material
  materialMarkup Decimal? @map("material_markup") @db.Decimal(9, 6)
  rj45SpareRate  Decimal? @map("rj45_spare_rate") @db.Decimal(9, 6)

  // Plataforma elevatória
  platformMonthlyRent  Decimal? @map("platform_monthly_rent") @db.Decimal(14, 2)
  platformDaysPerMonth Int?     @map("platform_days_per_month")
  platformFreight      Decimal? @map("platform_freight") @db.Decimal(14, 2)
  platformDailyBilled  Decimal? @map("platform_daily_billed") @db.Decimal(14, 2)

  // Indiretos e meta
  contingencyRate    Decimal? @map("contingency_rate") @db.Decimal(9, 6)
  overheadRate       Decimal? @map("overhead_rate") @db.Decimal(9, 6)
  commissionRate     Decimal? @map("commission_rate") @db.Decimal(9, 6)
  receivableDays     Int?     @map("receivable_days")
  moneyCostMonthly   Decimal? @map("money_cost_monthly") @db.Decimal(9, 6)
  targetProfitOnCost Decimal? @map("target_profit_on_cost") @db.Decimal(9, 6)

  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedBy   String    @map("updated_by")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  publishedBy String?   @map("published_by")
  publishedAt DateTime? @map("published_at")

  roles     ParameterSetRole[]
  revisions BudgetRevision[]

  @@index([status])
  @@map("parameter_sets")
}

/// Função da equipe num conjunto (técnico, encarregado, gerente…): valor cobrado e custo CLT.
model ParameterSetRole {
  id                    String   @id @default(uuid())
  parameterSetId        String   @map("parameter_set_id")
  roleKey               String   @map("role_key")
  label                 String
  fieldRole             Boolean  @default(true) @map("field_role")
  sortOrder             Int      @default(0) @map("sort_order")
  billingRate           Decimal? @map("billing_rate") @db.Decimal(14, 2)
  monthlySalary         Decimal? @map("monthly_salary") @db.Decimal(14, 2)
  plrSalariesPerYear    Decimal? @map("plr_salaries_per_year") @db.Decimal(8, 4)
  mealPerWorkedDay      Decimal? @map("meal_per_worked_day") @db.Decimal(14, 2)
  transportPerMonth     Decimal? @map("transport_per_month") @db.Decimal(14, 2)
  gymPerMonth           Decimal? @map("gym_per_month") @db.Decimal(14, 2)
  healthPerMonth        Decimal? @map("health_per_month") @db.Decimal(14, 2)
  otherBenefitsPerMonth Decimal? @map("other_benefits_per_month") @db.Decimal(14, 2)
  costPerHourOverride   Decimal? @map("cost_per_hour_override") @db.Decimal(14, 4)

  parameterSet ParameterSet @relation(fields: [parameterSetId], references: [id], onDelete: Cascade)

  @@unique([parameterSetId, roleKey])
  @@map("parameter_set_roles")
}

/// Catálogo de materiais cobrados à parte (miscelâneas). O orçamento copia preço e custo ao usar.
model BudgetMaterial {
  id           String   @id @default(uuid())
  name         String   @unique
  manufacturer String?
  partNumber   String?  @map("part_number")
  unit         String   @default("un")
  billedPrice  Decimal  @map("billed_price") @db.Decimal(14, 4)
  realCost     Decimal? @map("real_cost") @db.Decimal(14, 4)
  clientRef    String?  @map("client_ref") // ex.: linha no formulário do cliente
  active       Boolean  @default(true)
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedBy    String   @map("updated_by")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("budget_materials")
}

/// Destinos a partir da sede: km ida e volta e pedágio por dia.
model BudgetDestination {
  id          String   @id @default(uuid())
  name        String   @unique
  kmRoundTrip Decimal  @map("km_round_trip") @db.Decimal(10, 2)
  tollPerDay  Decimal  @default(0) @map("toll_per_day") @db.Decimal(14, 2)
  routeNotes  String?  @map("route_notes")
  active      Boolean  @default(true)
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedBy   String   @map("updated_by")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("budget_destinations")
}

// ---------------------------------------------------------------------------
// PJ2 — orçamento do projeto (projetos-especificacao §3, §5, §6 e §10).
// ---------------------------------------------------------------------------

enum BudgetModel {
  generico
  aws_sow
}

enum BudgetRevisionStatus {
  rascunho
  em_aprovacao
  enviada
  ganha
  perdida
  substituida
  descartada
}

/// Orçamento de um projeto do Core (um por projeto e modelo).
model ProjectBudget {
  id            String      @id @default(uuid())
  axisProjectId String      @map("axis_project_id")
  projectCode   String      @map("project_code") // cópia do código do Core no momento da criação
  model         BudgetModel @default(generico)
  /// Vazio = nome do projeto no Core (P-07).
  title            String?
  /// Vazio = data prevista do projeto no Core; preenchido = o orçamento sobrescreve (CHECK conclusão ≥ início).
  plannedStartDate DateTime? @map("planned_start_date") @db.Date
  plannedEndDate   DateTime? @map("planned_end_date") @db.Date
  createdBy     String      @map("created_by")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  revisions     BudgetRevision[]
  quoteRequests QuoteRequest[]
  alerts        BudgetAlert[]

  @@unique([axisProjectId, model])
  @@map("project_budgets")
}

/// Revisão numerada do orçamento. Entradas em JSON (validadas pelo DTO); totais em colunas para listar.
model BudgetRevision {
  id             String               @id @default(uuid())
  budgetId       String               @map("budget_id")
  number         Int
  status         BudgetRevisionStatus @default(rascunho)
  parameterSetId String               @map("parameter_set_id")
  inputs         Json
  result         Json?
  revenue        Decimal?             @db.Decimal(14, 2)
  taxes          Decimal?             @db.Decimal(14, 2)
  directCost     Decimal?             @map("direct_cost") @db.Decimal(14, 2)
  indirectCost   Decimal?             @map("indirect_cost") @db.Decimal(14, 2)
  profit         Decimal?             @db.Decimal(14, 2)
  profitOnCost   Decimal?             @map("profit_on_cost") @db.Decimal(9, 4)
  computedAt     DateTime?            @map("computed_at")
  /// Fluxo da revisão (PJ3): quando foi submetida, quem aprovou o envio e quando o cliente decidiu.
  submittedAt     DateTime?           @map("submitted_at")
  approvedAt      DateTime?           @map("approved_at")
  approvedBy      String?             @map("approved_by")
  approvedByEmail String?             @map("approved_by_email")
  decidedAt       DateTime?           @map("decided_at")
  notes          String?
  createdBy      String               @map("created_by")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedBy      String               @map("updated_by")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  budget       ProjectBudget @relation(fields: [budgetId], references: [id])
  parameterSet ParameterSet  @relation(fields: [parameterSetId], references: [id])
  events       BudgetRevisionEvent[]
  sow          BudgetRevisionSow?
  bidTemplate  RevisionBidTemplate?
  bidOutput    RevisionBidOutput?

  @@unique([budgetId, number])
  @@index([status])
  @@map("budget_revisions")
}

/// Alerta visível no orçamento (PT-07): situação que o Financeiro não resolve sozinho, como o Core aprovar uma
/// revisão enquanto outra já está ganha. Fica aberto até alguém dispensar.
model BudgetAlert {
  id         String    @id @default(uuid())
  budgetId   String    @map("budget_id")
  revisionId String?   @map("revision_id")
  /// ganha_conflito, revisao_fora_de_enviada, sem_centro_custo, comprometido_duplicado
  kind       String
  message    String
  /// Evento do Core que gerou o alerta, quando houve.
  eventId    String?   @map("event_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")
  resolvedBy String?   @map("resolved_by")

  budget ProjectBudget @relation(fields: [budgetId], references: [id])

  @@index([budgetId, resolvedAt])
  @@map("budget_alerts")
}

/// Histórico do fluxo da revisão (append-only: o banco recusa UPDATE e DELETE).
model BudgetRevisionEvent {
  id          String                @id @default(uuid())
  revisionId  String                @map("revision_id")
  /// submitted, returned, send_approved, won, lost, superseded, discarded
  action      String
  fromStatus  BudgetRevisionStatus  @map("from_status")
  toStatus    BudgetRevisionStatus  @map("to_status")
  reason      String?
  actorAxisId String                @map("actor_axis_id")
  actorEmail  String?               @map("actor_email")
  createdAt   DateTime              @default(now()) @map("created_at")

  revision BudgetRevision @relation(fields: [revisionId], references: [id])

  @@index([revisionId, createdAt])
  @@map("budget_revision_events")
}

/// Pedido de cotação vindo do Core (`project.quote_requested`, PJ4). A fila do orçamentista; o orçamento
/// `aws_sow` nasce quando alguém clica "Iniciar cotação".
model QuoteRequest {
  id                     String    @id @default(uuid())
  axisQuoteRequestId     String    @unique @map("axis_quote_request_id")
  axisProjectId          String    @map("axis_project_id")
  projectCode            String    @map("project_code")
  sowDocumentId          String    @map("sow_document_id")
  sowVersion             Int       @map("sow_version")
  sowFilename            String    @map("sow_filename")
  sowContentHash         String    @map("sow_content_hash")
  /// Nulo só em pedidos anteriores à exigência do Bid Template no Core.
  bidTemplateDocumentId  String?   @map("bid_template_document_id")
  bidTemplateVersion     Int?      @map("bid_template_version")
  bidTemplateFilename    String?   @map("bid_template_filename")
  bidTemplateContentHash String?   @map("bid_template_content_hash")
  notes                  String?
  requestedByEmail       String?   @map("requested_by_email")
  requestedAt            DateTime  @map("requested_at")
  eventId                String    @map("event_id")
  budgetId               String?   @map("budget_id")
  startedAt              DateTime? @map("started_at")
  startedBy              String?   @map("started_by")
  createdAt              DateTime  @default(now()) @map("created_at")

  budget           ProjectBudget?        @relation(fields: [budgetId], references: [id])
  sowUsage         BudgetRevisionSow[]
  bidTemplateUsage RevisionBidTemplate[]

  @@index([axisProjectId])
  @@map("quote_requests")
}

/// SOW lida na revisão (PJ4, §7.1): texto original (P-05: só para budget:write), o que o parser leu e as
/// linhas de cabo atuais (com as correções do orçamentista). Só muda com a revisão em rascunho.
model BudgetRevisionSow {
  revisionId     String   @id @map("revision_id")
  quoteRequestId String?  @map("quote_request_id")
  /// core_pdf (baixado do Core) ou texto (colado)
  source         String
  sowDocumentId  String?  @map("sow_document_id")
  sowVersion     Int?     @map("sow_version")
  pages          Int?
  rawText        String   @map("raw_text")
  header         Json
  devices        Json
  /// Linhas lidas pelo parser, para comparar com as corrigidas.
  parsedCables   Json     @map("parsed_cables")
  cables         Json
  warnings       Json
  /// Horas T digitadas à mão por tipo de cabo (§7.2); tipo ausente = proporcional às horas-meta.
  fieldHoursOverrides Json @default("{}") @map("field_hours_overrides")
  /// Justificativas (em inglês) dos indicadores fora da meta do cliente (§7.3).
  kpiJustifications   Json @default("{}") @map("kpi_justifications")
  importedAt     DateTime @default(now()) @map("imported_at")
  importedBy     String   @map("imported_by")
  updatedAt      DateTime @updatedAt @map("updated_at")
  updatedBy      String   @map("updated_by")

  revision     BudgetRevision @relation(fields: [revisionId], references: [id])
  quoteRequest QuoteRequest?  @relation(fields: [quoteRequestId], references: [id])

  @@map("budget_revision_sow")
}

/// Bid Template do RFQ usado na revisão (PJ4 parte 2, §7.3–§7.4): o arquivo do cliente (preenchido na PJ7)
/// e as metas lidas dele. Só muda com a revisão em rascunho.
model RevisionBidTemplate {
  revisionId     String   @id @map("revision_id")
  quoteRequestId String?  @map("quote_request_id")
  documentId     String   @map("document_id")
  version        Int
  filename       String
  contentHash    String   @map("content_hash")
  content        Bytes
  /// Saída de readBidTargets: cluster, moeda, câmbio, metas, pesos, tolerâncias e avisos.
  targets        Json
  importedAt     DateTime @default(now()) @map("imported_at")
  importedBy     String   @map("imported_by")

  revision     BudgetRevision @relation(fields: [revisionId], references: [id])
  quoteRequest QuoteRequest?  @relation(fields: [quoteRequestId], references: [id])

  @@map("revision_bid_template")
}

/// Perfil da Bid do cliente AWS (PJ7, §7.4): dados do fornecedor no cabeçalho e o mapeamento tipo de cabo /
/// função da equipe → linha do Bid Template (pelo código da coluna C). Fica no banco: valores e códigos do
/// cliente não vão para o repositório.
model BidProfileEntry {
  id        String   @id @default(uuid())
  /// header (key: vendorName, pocName, pocEmail, leadTimeDays), cable (key: tipo normalizado), role (key: roleKey)
  kind      String
  key       String
  value     Json
  updatedBy String   @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([kind, key])
  @@map("bid_profile_entries")
}

/// Bid preenchida ao aprovar o envio (PJ7). Append-only: nunca muda nem é apagada.
model RevisionBidOutput {
  revisionId  String   @id @map("revision_id")
  filename    String
  contentHash String   @map("content_hash")
  content     Bytes
  /// Células escritas e o mapeamento usado (para conferência).
  writes      Json
  generatedAt DateTime @default(now()) @map("generated_at")
  generatedBy String   @map("generated_by")

  revision BudgetRevision @relation(fields: [revisionId], references: [id])

  @@map("revision_bid_output")
}

// ---------------------------------------------------------------------------
// Centros de custo — controladoria (docs/centros-de-custo-especificacao.md).
// O CC vem do cache de mestres do Core (axis_master_cache, kind COST_CENTER); aqui ficam os fatos financeiros.
// ---------------------------------------------------------------------------

enum CcEntryKind {
  receita
  custo
}

enum CcEntryStage {
  comprometido
  realizado
}

enum CcEntrySource {
  compra
  reembolso
  adiantamento
  logistica
  folha
  manual
  /// Comprometido na revisão ganha (receita contratada e custos orçados, PT-07). Não entra no orçamento do CC.
  projeto
  /// Mão de obra realizada do projeto a partir das horas do Field (PT-10): o custo no CC do projeto e o crédito "mão de obra transferida" no CC de origem do técnico.
  mao_de_obra
}

enum CcCategory {
  faturamento
  folha
  material
  compras
  servicos
  despesas_campo
  frota
  outros
}

/// Lançamento de um CC. Append-only: correção por estorno (valor negativo com `reverses_id`).
model CcEntry {
  id               String        @id @default(uuid())
  costCenterAxisId String        @map("cost_center_axis_id")
  projectAxisId    String?       @map("project_axis_id")
  competence       DateTime      @db.Date
  kind             CcEntryKind
  category         CcCategory
  stage            CcEntryStage
  source           CcEntrySource
  amount           Decimal       @db.Decimal(14, 2)
  description      String
  /// Referência da origem (ex.: purchase:<request>:<grupo>, folha:2026-03:<cc>), para idempotência e substituição.
  sourceRef        String?       @map("source_ref")
  reversesId       String?       @unique @map("reverses_id")
  reason           String?
  createdBy        String        @map("created_by")
  createdAt        DateTime      @default(now()) @map("created_at")

  reverses   CcEntry? @relation("CcEntryReversal", fields: [reversesId], references: [id])
  reversedBy CcEntry? @relation("CcEntryReversal")

  @@index([costCenterAxisId, competence])
  @@index([projectAxisId, competence])
  @@index([sourceRef])
  @@map("cc_entries")
}

enum CcPurchaseStatus {
  aprovada
  pedido
  recebida_parcial
  recebida
  cancelada
}

/// Compra do Core acompanhada pelo funil (aprovada → pedido → recebida), um registro por requisição.
model CcPurchase {
  id               String           @id @default(uuid())
  requestAxisId    String           @unique @map("request_axis_id")
  code             String
  costCenterAxisId String           @map("cost_center_axis_id")
  projectAxisId    String?          @map("project_axis_id")
  total            Decimal          @db.Decimal(14, 2)
  status           CcPurchaseStatus
  /// Grupos de entrega: [{ group_id, supplier, total, stock, received }].
  groups           Json             @default("[]")
  approvedAt       DateTime?        @map("approved_at")
  orderedAt        DateTime?        @map("ordered_at")
  receivedAt       DateTime?        @map("received_at")
  cancelledAt      DateTime?        @map("cancelled_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@index([costCenterAxisId, status])
  @@map("cc_purchases")
}

enum CcAdvanceStatus {
  aberto
  prestado
}

/// Adiantamento aprovado no Core; fica em aberto até a prestação de contas.
model CcAdvance {
  id                 String          @id @default(uuid())
  requestAxisId      String          @unique @map("request_axis_id")
  requestCode        String          @map("request_code")
  collaboratorAxisId String          @map("collaborator_axis_id")
  costCenterAxisId   String          @map("cost_center_axis_id")
  projectAxisId      String?         @map("project_axis_id")
  amount             Decimal         @db.Decimal(14, 2)
  approvedAt         DateTime        @map("approved_at")
  status             CcAdvanceStatus @default(aberto)
  spentAmount        Decimal?        @map("spent_amount") @db.Decimal(14, 2)
  notes              String?
  settledAt          DateTime?       @map("settled_at")
  settledBy          String?         @map("settled_by")

  @@index([costCenterAxisId, status])
  @@index([collaboratorAxisId, status])
  @@map("cc_advances")
}

/// Orçamento anual do CC por mês e categoria de custo.
model CcBudget {
  id               String     @id @default(uuid())
  costCenterAxisId String     @map("cost_center_axis_id")
  year             Int
  month            Int
  category         CcCategory
  amount           Decimal    @db.Decimal(14, 2)
  updatedBy        String     @map("updated_by")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  @@unique([costCenterAxisId, year, month, category])
  @@map("cc_budgets")
}

/// Configuração do CC no Financeiro e última situação do orçamento avisada ao Core.
model CcSetting {
  costCenterAxisId  String   @id @map("cost_center_axis_id")
  fieldDailyLimit   Decimal? @map("field_daily_limit") @db.Decimal(14, 2)
  lastBudgetStatus  String?  @map("last_budget_status")
  lastBudgetYear    Int?     @map("last_budget_year")
  lastBudgetPercent Decimal? @map("last_budget_percent") @db.Decimal(9, 2)
  updatedBy         String?  @map("updated_by")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("cc_settings")
}

/// Vigência da alocação do colaborador no CC (evento collaborator.cost_center_changed). `valid_to` exclusivo.
model CcAllocation {
  id                 String    @id @default(uuid())
  collaboratorAxisId String    @map("collaborator_axis_id")
  costCenterAxisId   String    @map("cost_center_axis_id")
  validFrom          DateTime  @map("valid_from") @db.Date
  validTo            DateTime? @map("valid_to") @db.Date
  sourceEventId      String?   @map("source_event_id")

  @@index([collaboratorAxisId, validFrom])
  @@index([costCenterAxisId, validFrom])
  @@map("cc_allocations")
}

/// Cargo do Core → função do orçamento (parameter_set_roles.role_key), para o custo da folha por CC.
model JobTitleRoleMap {
  axisJobTitleId String   @id @map("axis_job_title_id")
  jobTitleName   String   @map("job_title_name")
  roleKey        String   @map("role_key")
  updatedBy      String   @map("updated_by")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("job_title_role_maps")
}

enum CcOverheadDriver {
  headcount
  receita
  custo_direto
  percentual
}

/// Regra de rateio do custo de um CC (origem) para outros (destinos), calculada na consulta.
model CcOverheadRule {
  sourceCostCenterAxisId String           @id @map("source_cost_center_axis_id")
  driver                 CcOverheadDriver
  active                 Boolean          @default(true)
  notes                  String?
  updatedBy              String           @map("updated_by")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  targets CcOverheadTarget[]

  @@map("cc_overhead_rules")
}

model CcOverheadTarget {
  ruleSourceId     String   @map("rule_source_id")
  costCenterAxisId String   @map("cost_center_axis_id")
  /// Fração (0.25 = 25%), só no direcionador `percentual`.
  percent          Decimal? @db.Decimal(9, 6)

  rule CcOverheadRule @relation(fields: [ruleSourceId], references: [sourceCostCenterAxisId], onDelete: Cascade)

  @@id([ruleSourceId, costCenterAxisId])
  @@map("cc_overhead_targets")
}

enum CcTeamActivity {
  projeto
  deslocamento
  treinamento
  manutencao
  ocioso
}

/// Diário da equipe técnica: o que a equipe fez no dia, horas, km e produção.
model CcTeamLog {
  id               String         @id @default(uuid())
  costCenterAxisId String         @map("cost_center_axis_id")
  date             DateTime       @db.Date
  activity         CcTeamActivity
  projectAxisId    String?        @map("project_axis_id")
  people           Int
  hoursPerPerson   Decimal        @map("hours_per_person") @db.Decimal(5, 2)
  km               Decimal?       @db.Decimal(10, 1)
  producedQuantity Decimal?       @map("produced_quantity") @db.Decimal(14, 3)
  producedUnit     String?        @map("produced_unit")
  notes            String?
  createdBy        String         @map("created_by")
  createdAt        DateTime       @default(now()) @map("created_at")

  @@index([costCenterAxisId, date])
  @@index([projectAxisId, date])
  @@map("cc_team_logs")
}

enum FieldLaborStatus {
  lancado
  pendente
}

/// Horas reais do Field por técnico, projeto e dia (PT-10, `GET /api/integration/labor-hours`): o estado vigente da
/// última importação. Os valores em dinheiro ficam só nos `cc_entries` (par de lançamentos `mao_de_obra`); aqui
/// ficam as horas (base do painel da equipe), o que ficou pendente e por quê. Reimportar o dia atualiza a linha.
model FieldLaborDay {
  id                      String           @id @default(uuid())
  collaboratorAxisId      String           @map("collaborator_axis_id")
  projectAxisId           String           @map("project_axis_id")
  date                    DateTime         @db.Date
  hours                   Decimal          @db.Decimal(8, 2)
  /// O Field marcou ajuste de timeline nas horas do dia.
  adjusted                Boolean          @default(false)
  status                  FieldLaborStatus
  /// Motivo da pendência: sem_funcao | sem_custo_funcao | projeto_desconhecido | projeto_sem_cc | sem_cc_origem.
  pendingReason           String?          @map("pending_reason")
  projectCostCenterAxisId String?          @map("project_cost_center_axis_id")
  originCostCenterAxisId  String?          @map("origin_cost_center_axis_id")
  importedAt              DateTime         @default(now()) @updatedAt @map("imported_at")

  @@unique([collaboratorAxisId, projectAxisId, date])
  @@index([date])
  @@index([originCostCenterAxisId, date])
  @@index([projectAxisId, date])
  @@map("field_labor_days")
}
