  cycle              Int
  categoryVersionId  String           @map("category_version_id")
  categoryVersion    CategoryVersion  @relation(fields: [categoryVersionId], references: [id])
  state              BpmInstanceState @default(draft)
  definitionSnapshot Json             @map("definition_snapshot")
  startedAt          DateTime?        @map("started_at")
  completedAt        DateTime?        @map("completed_at")
  closedAt           DateTime?        @map("closed_at")
  lastEventSequence  Int              @default(0) @map("last_event_sequence")
  tokens             ExecutionToken[]
  activities         ActivityInstance[]
  events             RequestRuntimeEvent[]
  incidents          RequestRuntimeIncident[]
  slaClocks          RequestSlaClock[]
