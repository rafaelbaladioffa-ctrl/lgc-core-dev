generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  disabled
}

enum CollaboratorStatus {
  ativo
  afastado
  ferias
  desligado
}

enum MaritalStatus {
  solteiro
  casado
  divorciado
  viuvo
  uniao_estavel
}

enum ContractType {
  CLT
  PJ
  estagio
  terceirizado
}

enum Gender {
  masculino
  feminino
  outro
  prefiro_nao_informar
}

enum CertificationType {
  NR10
  NR35
  NR12
  NR18
}

enum ProjectStatus {
  proposta
  aprovado
  em_execucao
  encerrado
}

enum ManagementLevel {
  colaborador
  supervisor
  coordenador
  gerente
  diretor
}

/// Natureza do centro de custo (docs/integracao-centros-de-custo.md §1). Raízes são `divisao`.
enum CostCenterKind {
  divisao
  administrativo
  operacional
  equipe_tecnica
}

/// Faixa de consumo do orçamento informada pelo Financeiro (§4): ok < 80%, alerta 80–99%, estourado ≥ 100%.
enum CostCenterBudgetStatus {
  ok
  alerta
  estourado
}

enum OutboxStatus {
  pending
  delivered
  failed
}

enum InboxStatus {
  processed
  ignored
  failed
}

enum SatelliteStatus {
  active
  inactive
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String    @map("password_hash")
  status         UserStatus @default(active)
  lastLoginAt    DateTime? @map("last_login_at")
  mustChangePassword Boolean @default(false) @map("must_change_password")
  collaboratorId String?   @unique @map("collaborator_id")
  collaborator   Collaborator? @relation(fields: [collaboratorId], references: [id])
  projectDocuments ProjectDocument[]
  projectQuoteRequests ProjectQuoteRequest[]
  projectAcceptances ProjectAcceptance[]
  refreshTokens  RefreshToken[]
  userRoles      UserRole[]
  auditLogs      AuditLog[]
  sensitiveAccessLogs SensitiveDataAccessLog[]
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model Role {
  id              String   @id @default(uuid())
  name            String   @unique
  description     String?
  rolePermissions RolePermission[]
  userRoles       UserRole[]
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model Permission {
  id              String   @id @default(uuid())
  resource        String
  action          String
  description     String?
  rolePermissions RolePermission[]
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Sector {
  id                         String   @id @default(uuid())
  code                       String   @unique
  name                       String
  parentSectorId             String?  @map("parent_sector_id")
  parentSector               Sector?  @relation("SectorHierarchy", fields: [parentSectorId], references: [id])
  subsectors                 Sector[] @relation("SectorHierarchy")
  responsibleCollaboratorId  String?  @map("responsible_collaborator_id")
  responsibleCollaborator    Collaborator? @relation("SectorResponsible", fields: [responsibleCollaboratorId], references: [id])
  costCenters                CostCenter[]
  collaborators              Collaborator[] @relation("CollaboratorSector")
  requestCategories          RequestCategory[]
  requestQueues              Queue[]
  requests                   Request[]
  delegations                Delegation[]
  approvalAuthorityRules     ApprovalAuthorityRule[]
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  @@index([parentSectorId])
  @@map("sectors")
}

model CostCenter {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  parentCostCenterId String? @map("parent_cost_center_id")
  parentCostCenter   CostCenter? @relation("CostCenterHierarchy", fields: [parentCostCenterId], references: [id])
  subCostCenters     CostCenter[] @relation("CostCenterHierarchy")
  sectorId  String   @map("sector_id")
  sector    Sector   @relation(fields: [sectorId], references: [id])
  responsibleCollaboratorId String? @map("responsible_collaborator_id")
  responsibleCollaborator Collaborator? @relation("CostCenterResponsible", fields: [responsibleCollaboratorId], references: [id])
  kind      CostCenterKind @default(administrativo)
  /// Sigla legível opcional e única (ex.: `DC-001-JAI`); não substitui o `code` gerado.
  shortCode String?  @unique @map("short_code")
  /// Situação do orçamento enviada pelo Financeiro (PUT /integration/cost-centers/:id/budget-status). Só leitura na API pública.
  budgetStatus   CostCenterBudgetStatus? @map("budget_status")
  budgetPercent  Decimal?  @map("budget_percent") @db.Decimal(6, 2)
  budgetYear     Int?      @map("budget_year")
  budgetStatusAt DateTime? @map("budget_status_at")
  projects  Project[]
  collaborators Collaborator[]
  collaboratorAllocations CollaboratorCostCenterAllocation[]
  requests  Request[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([parentCostCenterId])
  @@index([responsibleCollaboratorId])
  @@map("cost_centers")
}

model JobTitle {
  id            String   @id @default(uuid())
  name          String   @unique
  isTechnician  Boolean  @default(false) @map("is_technician")
  collaborators Collaborator[]
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("job_titles")
}

model WorkSchedule {
  id            String   @id @default(uuid())
  name          String
  startTime     String   @map("start_time")
  endTime       String   @map("end_time")
  breakMinutes  Int?     @map("break_minutes")
  daysOfWeek    String[] @map("days_of_week")
  collaborators Collaborator[]
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("work_schedules")
}

model Collaborator {
  id              String   @id @default(uuid())
  fullName        String   @map("full_name")
  rgEnc           String   @map("rg_enc")
  cpfEnc          String   @map("cpf_enc")
  cpfHash         String   @unique @map("cpf_hash")
  ctpsEnc         String?  @map("ctps_enc")
  pisEnc          String?  @map("pis_enc")
  personalEmail   String?  @map("personal_email")
  corporateEmail  String   @unique @map("corporate_email")
  jobTitleId      String   @map("job_title_id")
  jobTitle        JobTitle @relation(fields: [jobTitleId], references: [id])
  sectorId        String   @map("sector_id")
  sector          Sector   @relation("CollaboratorSector", fields: [sectorId], references: [id])
  supervisorId    String?  @map("supervisor_id")
  supervisor      Collaborator? @relation("CollaboratorHierarchy", fields: [supervisorId], references: [id])
  subordinates    Collaborator[] @relation("CollaboratorHierarchy")
  asoDate         DateTime? @map("aso_date")
  asoValidity     DateTime? @map("aso_validity")
  yellowBadge     String?  @map("yellow_badge")
  status          CollaboratorStatus @default(ativo)
  offboardedAt    DateTime? @map("offboarded_at")
  managementLevel ManagementLevel @default(colaborador) @map("management_level")
  matricula       String   @unique
  phone                 String?   @map("phone")
  emergencyContactName  String?   @map("emergency_contact_name")
  emergencyContactPhone String?   @map("emergency_contact_phone")
  birthDate             DateTime? @map("birth_date")
  maritalStatus         MaritalStatus? @map("marital_status")
  gender                Gender?   @map("gender")
  cep           String? @map("cep")
  addressStreet String? @map("address_street")
  addressNumber String? @map("address_number")
  addressComplement String? @map("address_complement")
  addressDistrict String? @map("address_district")
  addressCity   String? @map("address_city")
  addressState  String? @map("address_state")
  admissionDate  DateTime? @map("admission_date")
  contractType   ContractType? @map("contract_type")
  workScheduleId String?   @map("work_schedule_id")
  workSchedule   WorkSchedule? @relation(fields: [workScheduleId], references: [id])
  costCenterId   String?   @map("cost_center_id")
  costCenter     CostCenter? @relation(fields: [costCenterId], references: [id])
  costCenterAllocations CollaboratorCostCenterAllocation[]
  photoFilename    String? @map("photo_filename")
  photoStoragePath String? @map("photo_storage_path")
  uniformSize      String? @map("uniform_size")
  cnhCategory      String? @map("cnh_category")
  cnhNumber        String? @map("cnh_number")
  cnhExpiresAt     DateTime? @map("cnh_expires_at")
  /// Colaborador técnico do sistema ("Axis (automático)"): solicitante das requisições automáticas. Fora de listas e integrações.
  isSystem         Boolean  @default(false) @map("is_system")

  user                  User?
  sectorsResponsibleFor Sector[] @relation("SectorResponsible")
  costCentersResponsibleFor CostCenter[] @relation("CostCenterResponsible")
  certifications        TechnicianCertification[]
  sensitiveAccessLogs   SensitiveDataAccessLog[]
  projectsResponsibleFor Project[]
  requestsSubmitted     Request[] @relation("RequestRequester")
  requestsForBeneficiary Request[] @relation("RequestBeneficiary")
  requestsAssigned      Request[] @relation("RequestAssignee")
  requestComments       RequestComment[]
  requestAttachmentsUploaded RequestAttachment[]
  requestApprovals      RequestApproval[] @relation("RequestApprover")
  delegationsGiven      Delegation[] @relation("DelegationDelegator")
  delegationsReceived   Delegation[] @relation("DelegationDelegate")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([sectorId])
  @@index([supervisorId])
  @@index([jobTitleId])
  @@index([workScheduleId])
  @@index([costCenterId])
  @@map("collaborators")
}

/// Histórico de alocação do colaborador em centro de custo (docs/integracao-centros-de-custo.md §2).
/// `valid_to` é exclusivo (o último dia é `valid_to - 1`); nulo = vigente. No máximo uma vigente por
/// colaborador (índice único parcial criado na migração, fora do schema do Prisma).
model CollaboratorCostCenterAllocation {
  id             String       @id @default(uuid())
  collaboratorId String       @map("collaborator_id")
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id])
  costCenterId   String       @map("cost_center_id")
  costCenter     CostCenter   @relation(fields: [costCenterId], references: [id])
  validFrom      DateTime     @map("valid_from") @db.Date
  validTo        DateTime?    @map("valid_to") @db.Date
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([collaboratorId, validFrom])
  @@index([costCenterId])
  @@map("collaborator_cost_center_allocations")
}

model TechnicianCertification {
  id             String   @id @default(uuid())
  collaboratorId String   @map("collaborator_id")
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  type           CertificationType
  issuedAt       DateTime @map("issued_at")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([collaboratorId])
  @@index([expiresAt])
  @@map("technician_certifications")
}

model SensitiveDataAccessLog {
  id             String   @id @default(uuid())
  collaboratorId String   @map("collaborator_id")
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  actorUserId    String   @map("actor_user_id")
  actor          User     @relation(fields: [actorUserId], references: [id])
  fields         String[] @map("fields")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([collaboratorId])
  @@index([actorUserId])
  @@map("sensitive_data_access_logs")
}

model Client {
  id                String    @id @default(uuid())
  code              Int       @unique
  legalName         String    @map("legal_name")
  tradeName         String?   @map("trade_name")
  cnpj              String?   @unique
  phone             String?
  email             String?
  cep               String?   @map("cep")
  addressStreet     String?   @map("address_street")
  addressNumber     String?   @map("address_number")
  addressComplement String?   @map("address_complement")
  addressDistrict   String?   @map("address_district")
  addressCity       String?   @map("address_city")
  addressState      String?   @map("address_state")
  /// Legado (JSON livre, sem campo na tela). Use as colunas acima.
  contacts          Json?
  /// Legado (JSON livre, sem campo na tela). Use as colunas address_* acima.
  address           Json?
  projects          Project[]
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  sites             Site[]

  @@map("clients")
}

model Project {
  id                        String   @id @default(uuid())
  code                      String   @unique
  /// Obrigatório na API para criar e editar; projetos anteriores a 2026-11 podem estar sem nome.
  name                      String?
  plannedStartDate          DateTime? @map("planned_start_date") @db.Date
  plannedEndDate            DateTime? @map("planned_end_date") @db.Date
  clientId                  String   @map("client_id")
  client                    Client   @relation(fields: [clientId], references: [id])
  costCenterId               String   @map("cost_center_id")
  costCenter                 CostCenter @relation(fields: [costCenterId], references: [id])
  responsibleCollaboratorId String   @map("responsible_collaborator_id")
  responsibleCollaborator    Collaborator @relation(fields: [responsibleCollaboratorId], references: [id])
  status                    ProjectStatus @default(proposta)
  proposalSequence          Int      @map("proposal_sequence")
  requests                  Request[]
  documents                 ProjectDocument[]
  quoteRequests             ProjectQuoteRequest[]
  quotes                    ProjectQuote[]
  /// Aceite da aprovação (PA-07): qual revisão da cotação o cliente aceitou e o PO. Nulo enquanto for proposta.
  acceptance                ProjectAcceptance?
  /// Obra no Field (PT-09): vínculo e avanço informados pelos eventos `field.project.*`. Nulo até o Field avisar.
  fieldWork                 ProjectFieldWork?
  /// Local da obra (PA-05). Nulo até o PT-06 exigi-lo para aprovar o projeto; sempre do mesmo cliente.
  siteId                    String?  @map("site_id")
  site                      Site?    @relation(fields: [siteId], references: [id])
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  @@index([clientId])
  @@index([costCenterId])
  @@index([siteId])
  @@map("projects")
}

/// Obra do projeto no Field (PT-09 do plano projeto aprovado → obra). Uma linha por projeto, criada pelo primeiro
/// evento `field.project.*` recebido (qualquer um: a ordem de chegada não importa) e completada pelos demais.
/// Só horas e percentuais: custo, margem e salário ficam no Financeiro.
model ProjectFieldWork {
  id               String    @id @default(uuid())
  projectId        String    @unique @map("project_id")
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Id da obra no Field (inteiro lá, guardado como texto).
  fieldProjectId   String    @map("field_project_id")
  fieldProjectCode String?   @map("field_project_code")
  /// Link da obra no Field (absoluto ou relativo ao frontend do satélite).
  url              String?
  /// `generated`, `pending_review`, `failed` ou `no_sow` (`field.project.created`).
  sowPlanStatus    String?   @map("sow_plan_status")
  tasksCount       Int?      @map("tasks_count")
  createdInFieldAt DateTime? @map("created_in_field_at")
  startedAt        DateTime? @map("started_at")
  completedAt      DateTime? @map("completed_at")
  /// Último avanço recebido (`field.project.progress`); snapshot mais velho que este é ignorado.
  progressDate     DateTime? @map("progress_date") @db.Date
  progressEventAt  DateTime? @map("progress_event_at")
  percentComplete  Decimal?  @map("percent_complete") @db.Decimal(5, 2)
  tasksTotal       Int?      @map("tasks_total")
  tasksDone        Int?      @map("tasks_done")
  realManHours     Decimal?  @map("real_man_hours") @db.Decimal(12, 2)
  plannedManHours  Decimal?  @map("planned_man_hours") @db.Decimal(12, 2)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("project_field_works")
}

/// Site (local de obra ou de entrega) de um cliente, ex.: `GRU53`. Cadastro do Core usado por
/// Logística (endereço de entrega), Financeiro e Field. Sem exclusão: sai de uso inativando.
model Site {
  id                String   @id @default(uuid())
  clientId          String   @map("client_id")
  client            Client   @relation(fields: [clientId], references: [id])
  /// Código do site informado por quem cadastra (ex.: GRU53), único dentro do cliente.
  code              String
  name              String
  cep               String?
  addressStreet     String?  @map("address_street")
  addressNumber     String?  @map("address_number")
  addressComplement String?  @map("address_complement")
  addressDistrict   String?  @map("address_district")
  addressCity       String?  @map("address_city")
  addressState      String?  @map("address_state")
  latitude          Float?
  longitude         Float?
  active            Boolean  @default(true)
  projects          Project[]
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([clientId, code])
  @@index([clientId])
  @@map("sites")
}

enum ProjectDocumentKind {
  sow
  /// Bid Template do RFQ (planilha que o cliente manda junto com a SOW, já com os dados do projeto).
  bid_template
  /// Pedido de compra (PO) do cliente, anexado ao aprovar o projeto (PA-07). Aceita os mesmos tipos de arquivo dos anexos.
  po
}

/// Documento do projeto (ex.: SOW do cliente). Versionado: enviar de novo cria a versão seguinte;
/// nenhuma versão é sobrescrita nem apagada (só some com a exclusão da proposta).
model ProjectDocument {
  id               String              @id @default(uuid())
  projectId        String              @map("project_id")
  project          Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind             ProjectDocumentKind
  version          Int
  filename         String
  mimeType         String              @map("mime_type")
  sizeBytes        Int                 @map("size_bytes")
  contentHash      String              @map("content_hash")
  content          Bytes
  uploadedByUserId String              @map("uploaded_by_user_id")
  uploadedBy       User                @relation(fields: [uploadedByUserId], references: [id])
  quoteRequests    ProjectQuoteRequest[] @relation("QuoteRequestSow")
  quoteRequestsAsBidTemplate ProjectQuoteRequest[] @relation("QuoteRequestBidTemplate")
  quotes           ProjectQuote[]
  createdAt        DateTime            @default(now()) @map("created_at")

  @@unique([projectId, kind, version])
  @@map("project_documents")
}

/// Pedido de cotação ao Financeiro ("Solicitar cotação"). Histórico: cada pedido fica guardado e
/// emite `project.quote_requested` com a SOW vigente no momento.
model ProjectQuoteRequest {
  id                String          @id @default(uuid())
  projectId         String          @map("project_id")
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sowDocumentId     String          @map("sow_document_id")
  sowDocument       ProjectDocument @relation("QuoteRequestSow", fields: [sowDocumentId], references: [id], onDelete: Cascade)
  /// Bid Template vigente no pedido (obrigatório desde 2026-11-08; a coluna aceita nulo só pela ordem das migrações).
  bidTemplateDocumentId String?          @map("bid_template_document_id")
  bidTemplateDocument   ProjectDocument? @relation("QuoteRequestBidTemplate", fields: [bidTemplateDocumentId], references: [id], onDelete: Cascade)
  notes             String?
  requestedByUserId String          @map("requested_by_user_id")
  requestedBy       User            @relation(fields: [requestedByUserId], references: [id])
  createdAt         DateTime        @default(now()) @map("created_at")

  @@index([projectId])
  @@map("project_quote_requests")
}

/// Cotação devolvida pelo Financeiro: uma por revisão aprovada para envio. Traz a Bid preenchida e
/// a equipe orçada (quantidade por função × dias). Nunca traz custo, salário ou lucro.
model ProjectQuote {
  id                 String               @id @default(uuid())
  projectId          String               @map("project_id")
  project            Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  satelliteId        String               @map("satellite_id")
  satellite          IntegrationSatellite @relation(fields: [satelliteId], references: [id])
  /// Id da revisão no satélite; reenviar a mesma revisão não duplica.
  externalRevisionId String               @map("external_revision_id")
  revisionNumber     Int                  @map("revision_number")
  sowDocumentId      String?              @map("sow_document_id")
  sowDocument        ProjectDocument?     @relation(fields: [sowDocumentId], references: [id], onDelete: SetNull)
  workDays           Decimal              @map("work_days") @db.Decimal(8, 2)
  plannedStartDate   DateTime?            @map("planned_start_date") @db.Date
  plannedEndDate     DateTime?            @map("planned_end_date") @db.Date
  /// Linhas por função: role_key, role_name, field_role, people, days, hours.
  team               Json
  fieldPeople        Int                  @map("field_people")
  totalHours         Decimal              @map("total_hours") @db.Decimal(12, 2)
  approvedAt         DateTime?            @map("approved_at")
  approvedByEmail    String?              @map("approved_by_email")
  /// A Bid é opcional (o modelo generico do Financeiro não tem): ou as cinco colunas bid_* vêm preenchidas ou nenhuma (CHECK no banco).
  bidFilename        String?              @map("bid_filename")
  bidMimeType        String?              @map("bid_mime_type")
  bidSizeBytes       Int?                 @map("bid_size_bytes")
  bidContentHash     String?              @map("bid_content_hash")
  bidContent         Bytes?               @map("bid_content")
  receivedAt         DateTime             @default(now()) @map("received_at")
  /// Materiais a enviar ao site, com o código da Logística. Nunca traz preço nem custo.
  materials          ProjectQuoteMaterial[]
  acceptances        ProjectAcceptance[]

  @@unique([satelliteId, externalRevisionId])
  @@index([projectId])
  @@map("project_quotes")
}

/// Aceite do projeto (PT-06, PA-07): a revisão da cotação que o cliente aprovou e o PO. Um por projeto:
/// o projeto só passa a `aprovado` uma vez. Nasce na mesma transação da mudança de status.
model ProjectAcceptance {
  id               String       @id @default(uuid())
  projectId        String       @unique @map("project_id")
  project          Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectQuoteId   String       @map("project_quote_id")
  projectQuote     ProjectQuote @relation(fields: [projectQuoteId], references: [id])
  clientPoNumber   String?      @map("client_po_number")
  acceptedByUserId String       @map("accepted_by_user_id")
  acceptedBy       User         @relation(fields: [acceptedByUserId], references: [id])
  acceptedAt       DateTime     @default(now()) @map("accepted_at")

  @@index([projectQuoteId])
  @@map("project_acceptances")
}

/// Material da cotação (PT-05 do plano projeto aprovado → obra): código da Logística, descrição, unidade
/// e quantidade orçada. `logistics_material_id` é resolvido no servidor pelo código; fica nulo até a
/// consulta à Logística existir (PT-06). Sem preço, custo ou frete: isso fica só no Financeiro.
model ProjectQuoteMaterial {
  id                  String       @id @default(uuid())
  projectQuoteId      String       @map("project_quote_id")
  projectQuote        ProjectQuote @relation(fields: [projectQuoteId], references: [id], onDelete: Cascade)
  /// `Material.code` do catálogo da Logística.
  materialCode        String       @map("material_code")
  logisticsMaterialId String?      @map("logistics_material_id")
  description         String
  unit                String
  quantity            Decimal      @db.Decimal(14, 3)

  @@unique([projectQuoteId, materialCode])
  @@map("project_quote_materials")
}

enum RequestConfidentiality {
  interna
  confidencial
  restrita
}

enum RequestPriority {
  baixa
  normal
  alta
  critica
}

enum RequestStatus {
  rascunho
  enviada
  em_triagem
  aguardando_aprovacao
  aprovada
  planejada
  em_atendimento
  aguardando_solicitante
  aguardando_terceiro
  aguardando_correcao
  aguardando_informacao
  aguardando_entrega
  concluida
  encerrada
  devolvida_ajuste
  reprovada
  cancelada
  suspensa
  reaberta
  expirada
}

enum RequestApprovalStatus {
  pendente
  aprovado
  reprovado
  devolvido
}

enum RequestApprovalCompletionRule {
  todos
  qualquer_um
  n_de_m
}

enum RequestCommentVisibility {
  publico
  interno
}

enum SlaMetric {
  primeira_resposta
  solucao
}

enum RequestCategoryKind {
  padrao
  compra_material
  denuncia
  /// Envio de material para obra (PT-06): criada pelo sistema ao aprovar o projeto, nunca aberta pela tela.
  envio_material
}

enum CategoryVersionStatus {
  rascunho
  publicada
}

enum RequestExecutionMode {
  legacy
  bpm_v1
}

model RequestCategory {
  id              String                  @id @default(uuid())
  code            String                  @unique
  name            String
  sectorId        String                  @map("sector_id")
  sector          Sector                  @relation(fields: [sectorId], references: [id])
  /// Comportamento especial da categoria (substitui o teste por código/nome). Definido na criação.
  kind            RequestCategoryKind     @default(padrao)
  confidentiality RequestConfidentiality  @default(interna)
  active          Boolean                 @default(true)
  requiresAcceptance Boolean              @default(false) @map("requires_acceptance")
  useDynamicAuthority Boolean             @default(false) @map("use_dynamic_authority")
  versions        CategoryVersion[]
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  @@index([sectorId])
  @@map("request_categories")
}

model CategoryVersion {
  id                      String           @id @default(uuid())
  categoryId              String           @map("category_id")
  category                RequestCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  version                 Int
  formSchema              Json             @map("form_schema")
  workflowSchema          Json             @map("workflow_schema")
  slaFirstResponseMinutes Int              @map("sla_first_response_minutes")
  slaResolutionMinutes    Int              @map("sla_resolution_minutes")
  status                  CategoryVersionStatus @default(rascunho)
  /// NULL enquanto for rascunho.
  publishedAt             DateTime?        @map("published_at")
  publishedBy             String?          @map("published_by")
  createdBy               String?          @map("created_by")
  requests                Request[]
  createdAt               DateTime         @default(now()) @map("created_at")

  // No máximo um rascunho por categoria: índice único parcial `category_versions_one_draft_idx`
  // (`CREATE UNIQUE INDEX ... ON category_versions (category_id) WHERE status = 'rascunho'`),
  // criado à mão na migração 20261122000000 — o Prisma não modela índices parciais. Não remova.
  @@unique([categoryId, version])
  @@index([categoryId])
  @@map("category_versions")
}

model Queue {
  id        String    @id @default(uuid())
  sectorId  String    @map("sector_id")
  sector    Sector    @relation(fields: [sectorId], references: [id])
  name      String
  active    Boolean   @default(true)
  revision  Int       @default(0)
  requests  Request[]
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([sectorId])
  @@map("queues")
}

model Request {
  id                    String                  @id @default(uuid())
  code                  String                  @unique
  categoryVersionId     String                  @map("category_version_id")
  categoryVersion       CategoryVersion         @relation(fields: [categoryVersionId], references: [id])
  sectorId              String                  @map("sector_id")
  sector                Sector                  @relation(fields: [sectorId], references: [id])
  queueId               String?                 @map("queue_id")
  queue                 Queue?                  @relation(fields: [queueId], references: [id])
  requesterId           String                  @map("requester_id")
  requester             Collaborator            @relation("RequestRequester", fields: [requesterId], references: [id])
  beneficiaryId         String                  @map("beneficiary_id")
  beneficiary           Collaborator            @relation("RequestBeneficiary", fields: [beneficiaryId], references: [id])
  assigneeId            String?                 @map("assignee_id")
  assignee              Collaborator?           @relation("RequestAssignee", fields: [assigneeId], references: [id])
  title                 String
  description           String
  priority              RequestPriority         @default(normal)
  confidentiality       RequestConfidentiality  @default(interna)
  status                RequestStatus           @default(rascunho)
  executionMode         RequestExecutionMode   @default(legacy) @map("execution_mode")
  currentCycle          Int                   @default(0) @map("current_cycle")
  requesterSectorId     String?               @map("requester_sector_id")
  completedAt           DateTime?             @map("completed_at")
  firstResponseAt       DateTime?             @map("first_response_at")
  neededBy              DateTime?               @map("needed_by")
  projectId             String?                 @map("project_id")
  project               Project?                @relation(fields: [projectId], references: [id])
  costCenterId          String?                 @map("cost_center_id")
  costCenter            CostCenter?             @relation(fields: [costCenterId], references: [id])
  estimatedValue        Decimal?                @map("estimated_value") @db.Decimal(19, 4)
  currency              String                  @default("BRL")
  formData              Json?                   @map("form_data")
  /// Quem originou a requisição quando não foi uma pessoa (ex.: `projeto_aprovado`). Nulo nas abertas pela tela.
  origin                String?
  /// Chave do que originou (ex.: id da cotação aceita). (`origin`, `source_ref`) único: não duplica a requisição automática.
  sourceRef             String?                 @map("source_ref")
  anonymous             Boolean                 @default(false)
  lockVersion           Int                     @default(0) @map("lock_version")
  submittedAt           DateTime?               @map("submitted_at")
  slaDueFirstResponseAt DateTime?               @map("sla_due_first_response_at")
  slaDueResolutionAt    DateTime?               @map("sla_due_resolution_at")
  escalatedAt           DateTime?               @map("escalated_at")
  escalationLevel       Int                     @default(0) @map("escalation_level")
  closedAt              DateTime?               @map("closed_at")
  requesterAcceptedAt   DateTime?               @map("requester_accepted_at")
  comments              RequestComment[]
  attachments           RequestAttachment[]
  approvals             RequestApproval[]
  slaClocks             SlaClock[]
  relationsAsSource     RequestRelation[] @relation("RequestRelationSource")
  relationsAsTarget     RequestRelation[] @relation("RequestRelationTarget")
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")

  @@index([categoryVersionId])
  @@index([sectorId])
  @@index([queueId])
  @@index([status])
  @@index([requesterId])
  @@index([assigneeId])
  @@index([executionMode, requesterId, createdAt, id])
  @@index([executionMode, queueId, status, createdAt, id])
  @@index([executionMode, categoryVersionId, status])
  @@unique([origin, sourceRef])
  @@map("requests")
}

model RequestNumberCounter {
  year      Int @id
  lastValue Int @default(0) @map("last_value")

  @@map("request_number_counters")
}

model RequestApproval {
  id             String                          @id @default(uuid())
  requestId      String                          @map("request_id")
  request        Request                         @relation(fields: [requestId], references: [id], onDelete: Cascade)
  stepOrder      Int                             @map("step_order")
  requiredLevel  ManagementLevel?                @map("required_level")
  approverId     String                          @map("approver_id")
  approver       Collaborator                    @relation("RequestApprover", fields: [approverId], references: [id])
  status         RequestApprovalStatus           @default(pendente)
  completionRule RequestApprovalCompletionRule   @default(todos) @map("completion_rule")
  requiredCount  Int?                            @map("required_count")
  approvalSource String                          @default("hierarquia") @map("approval_source")
  decidedAt      DateTime?                       @map("decided_at")
  comment        String?
  createdAt      DateTime                        @default(now()) @map("created_at")

  @@index([requestId])
  @@index([approverId])
  @@map("approvals")
}

model RequestComment {
  id         String                   @id @default(uuid())
  requestId  String                   @map("request_id")
  request    Request                  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId   String                   @map("author_id")
  author     Collaborator             @relation(fields: [authorId], references: [id])
  visibility RequestCommentVisibility @default(publico)
  body       String
  createdAt  DateTime                 @default(now()) @map("created_at")

  @@index([requestId])
  @@map("request_comments")
}

model RequestAttachment {
  id                String              @id @default(uuid())
  requestId         String              @map("request_id")
  request           Request             @relation(fields: [requestId], references: [id], onDelete: Cascade)
  filename          String
  safeFilename      String              @map("safe_filename")
  mimeType          String              @map("mime_type")
  sizeBytes         Int                 @map("size_bytes")
  contentHash       String              @map("content_hash")
  content           Bytes
  version           Int                 @default(1)
  previousVersionId String?             @map("previous_version_id")
  previousVersion   RequestAttachment?  @relation("AttachmentVersion", fields: [previousVersionId], references: [id])
  nextVersions      RequestAttachment[] @relation("AttachmentVersion")
  uploadedBy        String              @map("uploaded_by")
  uploader          Collaborator        @relation(fields: [uploadedBy], references: [id])
  createdAt         DateTime            @default(now()) @map("created_at")

  @@index([requestId])
  @@map("request_attachments")
}

model SlaClock {
  id        String     @id @default(uuid())
  requestId String     @map("request_id")
  request   Request    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  metric    SlaMetric
  targetAt  DateTime   @map("target_at")
  startedAt DateTime   @default(now()) @map("started_at")
  pausedAt  DateTime?  @map("paused_at")
  stoppedAt DateTime?  @map("stopped_at")
  breached  Boolean    @default(false)
  alertedThresholds Int[] @default([]) @map("alerted_thresholds")

  @@index([requestId])
  @@map("sla_clocks")
}

model Holiday {
  id        String   @id @default(uuid())
  date      DateTime @db.Date
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([date])
  @@map("holidays")
}

model AuditEvent {
  id            String   @id @default(uuid())
  aggregateType String   @map("aggregate_type")
  aggregateId   String   @map("aggregate_id")
  event         String
  actorId       String?  @map("actor_id")
  beforeJson    Json?    @map("before_json")
  afterJson     Json?    @map("after_json")
  correlationId String?  @map("correlation_id")
  source        String   @default("api")
  occurredAt    DateTime @default(now()) @map("occurred_at")

  @@index([aggregateType, aggregateId])
  @@index([occurredAt])
  @@map("audit_events")
}

enum RequestRelationType {
  depende_de
  bloqueia
  duplica
  origina
  subtarefa_de
}

model Delegation {
  id          String       @id @default(uuid())
  delegatorId String       @map("delegator_id")
  delegator   Collaborator @relation("DelegationDelegator", fields: [delegatorId], references: [id])
  delegateId  String       @map("delegate_id")
  delegate    Collaborator @relation("DelegationDelegate", fields: [delegateId], references: [id])
  sectorId    String?      @map("sector_id")
  sector      Sector?      @relation(fields: [sectorId], references: [id])
  startsAt    DateTime     @map("starts_at")
  endsAt      DateTime     @map("ends_at")
  approvedBy  String?      @map("approved_by")
  revokedAt   DateTime?    @map("revoked_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([delegatorId])
  @@index([delegateId])
  @@map("delegations")
}

model RequestRelation {
  id           String              @id @default(uuid())
  sourceId     String              @map("source_id")
  source       Request             @relation("RequestRelationSource", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId     String              @map("target_id")
  target       Request             @relation("RequestRelationTarget", fields: [targetId], references: [id], onDelete: Cascade)
  relationType RequestRelationType @map("relation_type")
  createdAt    DateTime            @default(now()) @map("created_at")

  @@index([sourceId])
  @@index([targetId])
  @@map("request_relations")
}

model ApprovalAuthorityRule {
  id        String            @id @default(uuid())
  sectorId  String?           @map("sector_id")
  sector    Sector?           @relation(fields: [sectorId], references: [id])
  minValue  Decimal           @map("min_value") @db.Decimal(19, 4)
  maxValue  Decimal?          @map("max_value") @db.Decimal(19, 4)
  levels    ManagementLevel[]
  active    Boolean           @default(true)
  createdAt DateTime          @default(now()) @map("created_at")

  @@index([sectorId])
  @@map("approval_authority_rules")
}

model IntegrationOutbox {
  id          String       @id @default(uuid())
  eventType   String       @map("event_type")
  payload     Json
  status      OutboxStatus @default(pending)
  attempts    Int          @default(0)
  lastError   String?      @map("last_error")
  nextAttemptAt DateTime   @default(now()) @map("next_attempt_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  deliveredAt DateTime?    @map("delivered_at")

  @@index([status, nextAttemptAt])
  @@map("integration_outbox")
}

model IntegrationSatellite {
  id            String          @id @default(uuid())
  name          String          @unique
  webhookUrl    String          @map("webhook_url")
  frontendUrl   String?         @map("frontend_url")
  hmacSecretEnc String          @map("hmac_secret_enc")
  apiKeyHash    String          @map("api_key_hash")
  status        SatelliteStatus @default(active)
  subscriptions IntegrationSubscription[]
  projectQuotes ProjectQuote[]
  inbox         IntegrationInbox[]
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@map("integration_satellites")
}

/// Eventos recebidos dos satélites (POST /integration/inbound). `(satellite_id, event_id)` único:
/// é a chave de deduplicação — um reenvio de evento já processado ou ignorado não reprocessa.
model IntegrationInbox {
  id          String      @id @default(uuid())
  satelliteId String      @map("satellite_id")
  satellite   IntegrationSatellite @relation(fields: [satelliteId], references: [id], onDelete: Cascade)
  eventId     String      @map("event_id")
  eventType   String      @map("event_type")
  payload     Json
  status      InboxStatus
  error       String?
  receivedAt  DateTime    @default(now()) @map("received_at")
  processedAt DateTime?   @map("processed_at")

  @@unique([satelliteId, eventId])
  @@index([receivedAt])
  @@index([status, receivedAt])
  @@map("integration_inbox")
}

model IntegrationSubscription {
  satelliteId String   @map("satellite_id")
  satellite   IntegrationSatellite @relation(fields: [satelliteId], references: [id], onDelete: Cascade)
  eventType   String   @map("event_type")

  @@id([satelliteId, eventType])
  @@map("integration_subscriptions")
}

model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String   @map("actor_user_id")
  actor        User     @relation(fields: [actorUserId], references: [id])
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([actorUserId])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}
