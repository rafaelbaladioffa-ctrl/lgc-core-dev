model ActivityInstance {
  id             String            @id @default(uuid())
  instanceId     String            @map("instance_id")
  instance       ProcessInstance   @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  nodeId         String            @map("node_id")
  tokenId        String            @map("token_id")
  token          ExecutionToken    @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  activationKey  String            @map("activation_key")
  kind           BpmActivityKind   @default(human)
  phase          BpmActivityPhase
  state          BpmActivityState  @default(available)
  queueId        String?           @map("queue_id")
  queue          Queue?            @relation(fields: [queueId], references: [id])
  assigneeId     String?           @map("assignee_id")
  assignee       Collaborator?     @relation("BpmAssignee", fields: [assigneeId], references: [id])
  round          Int               @default(1)
  inputRevision  Int               @default(0) @map("input_revision")
  openedAt       DateTime          @default(now()) @map("opened_at")
  claimedAt      DateTime?         @map("claimed_at")
  completedAt    DateTime?         @map("completed_at")
  outcome             String?
  resolution          String?
  correctionFieldKeys Json?             @map("correction_field_keys")
  question            String?
  informationDueAt    DateTime?         @map("information_due_at")
  parentActivityId    String?           @map("parent_activity_id")
  parentActivity      ActivityInstance? @relation("ActivityParent", fields: [parentActivityId], references: [id])
  childActivities     ActivityInstance[] @relation("ActivityParent")
  candidates     ActivityCandidate[]
  assignments    ActivityAssignment[]
  participants   RequestParticipant[]
  comments       BpmRequestComment[]
  attachments    BpmRequestAttachment[]
  slaClocks      RequestSlaClock[]
  incidents      RequestRuntimeIncident[]
  @@unique([instanceId, activationKey])
  @@index([queueId, state, openedAt, id])
  @@index([assigneeId, state, openedAt, id])
  @@index([instanceId, state])
  @@map("bpm_activity_instances")
}

model ActivityCandidate {
  id             String           @id @default(uuid())
  activityId     String           @map("activity_id")
  activity       ActivityInstance @relation(fields: [activityId], references: [id], onDelete: Cascade)
