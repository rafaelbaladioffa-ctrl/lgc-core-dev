  actorUserId String?         @map("actor_user_id")
  @@index([clockId, endAt])
  @@map("bpm_sla_intervals")
}

model BpmRequestComment {
  id                  String            @id @default(uuid())
  requestId           String            @map("request_id")
  request             Request           @relation(fields: [requestId], references: [id], onDelete: Cascade)
  activityId          String?           @map("activity_id")
  activity            ActivityInstance? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  authorUserId        String            @map("author_user_id")
  authorCollaboratorId String?          @map("author_collaborator_id")
  authorCollaborator  Collaborator?     @relation(fields: [authorCollaboratorId], references: [id])
  body                String
  visibility          RequestCommentVisibility @default(publico)
  createdAt           DateTime          @default(now()) @map("created_at")
  @@index([requestId, createdAt])
  @@map("bpm_request_comments")
}

model BpmRequestAttachment {
  id           String            @id @default(uuid())
  requestId    String            @map("request_id")
  request      Request           @relation(fields: [requestId], references: [id], onDelete: Cascade)
  activityId   String?           @map("activity_id")
  activity     ActivityInstance? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  filename     String
  safeFilename String            @map("safe_filename")
  mimeType     String            @map("mime_type")
  sizeBytes    Int               @map("size_bytes")
  contentHash  String            @map("content_hash")
  content      Bytes
  fieldKey     String?           @map("field_key")
  version      Int               @default(1)
  previousId   String?           @map("previous_id")
  uploadedBy   String            @map("uploaded_by")
  createdAt    DateTime          @default(now()) @map("created_at")
  @@index([requestId])
  @@map("bpm_request_attachments")
}
