DATABASE_URL="postgresql://axis:axis@localhost:5432/axis?schema=public"
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
# 64 hex chars = 32 bytes, used as AES-256-GCM key for encrypting sensitive collaborator fields
FIELD_ENCRYPTION_KEY="generate-with-openssl-rand-hex-32"
PORT=3000
# Admin criado pelo seed (prisma/seed.ts). Sem SEED_ADMIN_PASSWORD o seed gera uma senha aleatória e a imprime no log.
SEED_ADMIN_EMAIL="admin@axis.local"
# SEED_ADMIN_PASSWORD="troque-esta-senha"
# Testes de integração (npm run test:e2e): PostgreSQL local dedicado, nome terminado em _test. Nunca o banco de dev.
# TEST_DATABASE_URL="postgresql://axis:axis@localhost:5432/axis_test?schema=public"
# Origens autorizadas a chamar esta API direto do navegador (CORS) — satélites como a Logística
# fazem login/chamadas JWT direto daqui, cada um com seu próprio frontend/origem
# (docs/integracao-core-logistica.md §1). Lista separada por vírgula; sem esta var, cai num default só de
# dev (localhost:5173/5174). Em produção, defina sempre com os domínios reais.
# CORS_ALLOWED_ORIGINS="https://axis.lgc.com.br,https://logistica.lgc.com.br"
