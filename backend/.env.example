DATABASE_URL="postgresql://logistica:logistica@localhost:5433/axis_logistica?schema=public"
# Mesmo segredo de acesso (HS256) usado pelo Axis para assinar o JWT (JWT_ACCESS_SECRET do Axis) — SSO, sem login próprio.
JWT_SECRET="replace-with-same-value-as-axis-JWT_ACCESS_SECRET"
PORT=3100

# Segredo HMAC compartilhado com o Axis (satélite cadastrado no Axis)
AXIS_WEBHOOK_SECRET="dev-webhook-secret-change-me-0123456789"
WEBHOOK_MAX_AGE_HOURS=72
DEFAULT_WAREHOUSE_CODE=""
