DJANGO_DEBUG=1
DJANGO_SECRET_KEY=troque-esta-chave-em-producao
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp
POSTGRES_HOST=field-postgres
POSTGRES_PORT=5432

# O superusuario e criado automaticamente apenas se estas 3 variaveis existirem.
DJANGO_SUPERUSER_EMAIL=admin@empresa.com
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=altere-esta-senha

# Envio de e-mail via Gmail (SMTP com senha de app)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=troque-pela-senha-de-app-do-gmail
DEFAULT_FROM_EMAIL=seu-email@gmail.com

# Remetente separado para recuperação de senha (opcional — vazio usa o de cima)
AUTH_FROM_EMAIL=
AUTH_EMAIL_HOST_USER=
AUTH_EMAIL_HOST_PASSWORD=
# AUTH_EMAIL_HOST / AUTH_EMAIL_PORT / AUTH_EMAIL_USE_TLS só se o provedor for diferente

# Origens permitidas para o frontend (React) acessar a API
CORS_ALLOWED_ORIGINS=http://localhost:5176

# URL da API que o frontend (container) deve usar
FRONTEND_API_URL=http://localhost:8000/api

# IA usada pelo parser de SOW (Planejamento > Importar SOW). AI_API_KEY
# vazia (padrão) faz o modulo funcionar em modo DETERMINISTIC_ONLY, sem
# IA nenhuma - nunca quebra a importacao. Nunca commitar uma chave real
# aqui; preencher so no .env real do servidor.
AI_PROVIDER=openrouter
AI_API_KEY=
AI_MODEL=openrouter/free
AI_BASE_URL=https://openrouter.ai/api/v1
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_NAME=Axis Field


# Integração com o Axis Core (docs/integracao-core-field.md §3). Nunca commitar valores reais.
# Segredo do webhook: o mesmo que o Core usa para assinar (X-Axis-Signature). Vazio = receptor responde 503.
AXIS_WEBHOOK_SECRET=
# Janela anti-replay do webhook, em horas (o Core reentrega com backoff).
AXIS_WEBHOOK_MAX_AGE_HOURS=72
# API de consulta do Core, usada por `manage.py axis_sync` e para completar eventos magros.
# AXIS_API_URL termina em /api/v1 (ex.: http://localhost:3000/api/v1); AXIS_API_KEY é a chave do satélite no Core.
AXIS_API_URL=
AXIS_API_KEY=
AXIS_API_TIMEOUT=15

# Field -> Core (PT-08): eventos field.project.created/started/progress/completed.
# Segredo HMAC do satélite Field cadastrado no Core (X-Field-Signature). Vazio = eventos ficam na fila sem envio.
AXIS_OUTBOUND_SECRET=
AXIS_OUTBOUND_TIMEOUT=10
# Tentativas antes de o evento ir para "esgotou" (backoff exponencial, até 1 h entre tentativas).
AXIS_OUTBOUND_MAX_ATTEMPTS=12
# 1 = tenta enviar logo após o commit; 0 = só o comando `manage.py axis_outbox_dispatch`.
AXIS_OUTBOUND_IMMEDIATE=1
# 1 = o plano da SOW e o envio imediato rodam em thread depois do commit; 0 = na hora (testes).
AXIS_BACKGROUND_TASKS=1
AXIS_SOW_DOWNLOAD_TIMEOUT=30
AXIS_SOW_MAX_MB=25
# Horas reais para o Financeiro (`GET /api/integration/labor-hours`, X-Api-Key). Vazia = a rota responde 503.
FIELD_INTEGRATION_API_KEY=
